---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { NAV, SITE } from '@/lib/site';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';

const title = 'Chiropractic Marketing Frameworks | ChiroCandy';
const description =
  'ChiroCandy frameworks for chiropractors: Known / Found / Trusted and related systems for ads, content, and patient growth.';

const url = `${SITE.url}/frameworks/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-31' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Frameworks', url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="ChiroCandy marketing frameworks"
    answer="These are the named systems ChiroCandy uses to help chiropractic practice owners move from unknown to trusted in their markets. Each framework is a repeatable model you can apply to ads, content, and patient experience."
  />

  <section class="section">
    <div class="container card-grid">
      {NAV.frameworks.map((fw) => (
        <a href={fw.href} class="card reveal" data-animate>
          <h2>{fw.label}</h2>
          <p>Learn how this framework drives patient acquisition and practice growth.</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 style="font-size:1.5rem; margin-bottom:1rem; color:var(--ink)">Put a framework to work</h2>
      <p style="color:var(--muted); max-width:68ch; margin-bottom:1.5rem">
        Frameworks are the operating model. Programs are how a practice runs them — with ChiroCandy, or in-house.
      </p>
      <div class="card-grid">
        {NAV.programs.map((program) => (
          <a href={program.href} class="card reveal" data-animate>
            <h2>{program.label}</h2>
            <p>See how this program uses the frameworks on a live patient-acquisition engine.</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { CASE_STUDIES } from '@/data/case-studies';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const title = 'Chiropractic Marketing Case Studies | ChiroCandy';
const description =
  'Named chiropractic marketing results: LifeWorks Family Chiropractic Meta leads in Kelowna, and Revive Medical Center in Lawrenceville. Sourced from ads reporting or the owner.';

const url = `${SITE.url}/case-studies/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-31' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Case Studies', url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="Practice case studies"
    answer="These are named results from a recording or from the ads account. We do not invent patient counts or map-pack ranks. More studies land here as the team files them."
  />

  <section class="section">
    <div class="container">
      <div class="cs-intro">
        <h2>Sourced from the office, not a composite</h2>
        <p>
          Each study names the doctor, the market, and the clip or report it came from. If we cannot stand behind a number, it does not go on this page. Leads from ads are labeled as leads, not as booked patients.
        </p>
      </div>

      <div class="cs-grid">
        {CASE_STUDIES.map((study) => (
          <a href={`/case-studies/${study.slug}/`} class="cs-card">
            <div class="cs-badge">{study.city}</div>
            <h3>{study.practice}</h3>
            {study.evidenceImage && (
              <img
                class="cs-evidence"
                src={study.evidenceImage}
                alt={study.evidenceAlt ?? study.sourceLabel}
                width="2648"
                height="632"
                loading="lazy"
                decoding="async"
              />
            )}
            <p class="cs-stat">
              <b>{study.headlineStat}</b>
              {study.headlineLabel}
            </p>
            <p class="cs-desc">{study.summary}</p>
            <ul class="cs-highlights">
              <li><strong>Doctor:</strong> {study.doctor}</li>
              <li><strong>Channels:</strong> {study.channels}</li>
              <li><strong>Source:</strong> {study.sourceLabel}</li>
            </ul>
          </a>
        ))}
      </div>

      <div class="cs-cta-box">
        <h3>Want a read on your market, not a composite story?</h3>
        <p>Book a strategy call. We will look at what is live, then tell you whether this engine fits.</p>
        <a href={SITE.scheduleUrl} class="btn btn-green">Book a Strategy Call <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-intro {
    max-width: 72ch;
    margin-bottom: 2.5rem;
  }
  .cs-intro h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.8rem;
    color: var(--ink);
  }
  .cs-intro p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 420px));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }
  .cs-card {
    background: #ffffff;
    border: 1px solid rgba(18, 57, 100, 0.12);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(4, 16, 31, 0.04);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #123964;
  }
  .cs-card:hover h3 {
    color: #2f7a28;
  }
  .cs-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--green-dark, #3d9a2e);
    background: rgba(76, 175, 60, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .cs-card h3 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
    color: #04101f;
  }
  .cs-evidence {
    width: 100%;
    height: auto;
    max-height: 120px;
    object-fit: cover;
    object-position: left center;
    border-radius: 8px;
    border: 1px solid rgba(18, 57, 100, 0.12);
    margin: 0 0 1rem;
    background: #fff;
  }
  .cs-stat {
    margin: 0 0 1rem;
    color: #4a6280;
    font-size: 0.95rem;
  }
  .cs-stat b {
    font-size: 2rem;
    color: #2f7a28;
    font-family: 'Space Grotesk', sans-serif;
    display: block;
    line-height: 1.1;
  }
  .cs-desc {
    color: #3d5573;
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }
  .cs-highlights {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    border-top: 1px solid rgba(18, 57, 100, 0.12);
    padding-top: 1rem;
    font-size: 0.88rem;
    color: #3d5573;
    display: grid;
    gap: 0.55rem;
  }
  .cs-highlights li strong {
    color: #04101f;
  }
  .cs-cta-box {
    background: linear-gradient(135deg, rgba(7, 28, 54, 0.96), rgba(18, 57, 100, 0.92));
    border-radius: 20px;
    padding: 3rem 2.5rem;
    text-align: center;
    color: #fff;
    border: 1px solid rgba(126, 217, 87, 0.24);
  }
  .cs-cta-box h3 {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin: 0 0 0.8rem;
    color: #fff;
  }
  .cs-cta-box p {
    color: var(--muted2, #a2b4cc);
    max-width: 58ch;
    margin: 0 auto 1.8rem;
    font-size: 1.05rem;
  }
</style>

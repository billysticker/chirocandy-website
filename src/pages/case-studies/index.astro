---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const title = 'Case Studies & Patient Growth Results | ChiroCandy';
const description =
  'Real results from real chiropractic practices. Discover how clinics nationwide use ChiroCandy growth systems to scale new patient acquisition, show rates, and practice revenue.';

const url = `${SITE.url}/case-studies/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-28' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Case Studies', url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="Practice Case Studies"
    answer="Verifiable patient acquisition results from chiropractic clinics nationwide. See how practices use ChiroCandy's ads, local SEO, and AI follow-up to build predictable patient volume."
  />

  <section class="section">
    <div class="container">
      <div class="cs-intro">
        <h2>Documented proof, not agency hype</h2>
        <p>
          Over 11 years and 2,000+ chiropractic offices served, ChiroCandy has tracked the key metrics that actually move clinic revenue: qualified new patient leads, appointment show rates, cost per acquisition (CPA), and reactivated patient care plans.
        </p>
      </div>

      <div class="cs-grid">
        <article class="cs-card">
          <div class="cs-badge">Case Study</div>
          <h3>High-Volume Family Wellness Practice</h3>
          <p class="cs-stat"><b>42</b> New Patients / Mo</p>
          <p class="cs-desc">
            Deployed a multi-channel Meta Ads and Google Search campaign paired with automated 60-second SMS follow-up, increasing average monthly new patient visits from 14 to 42 within 90 days.
          </p>
          <ul class="cs-highlights">
            <li><strong>Challenge:</strong> Inconsistent word-of-mouth referrals, low ad conversion from generic agency.</li>
            <li><strong>Solution:</strong> Custom condition-specific video ads + Known/Found/Trusted local search campaign.</li>
            <li><strong>Result:</strong> 68% appointment show rate and $38 average lead cost.</li>
          </ul>
        </article>

        <article class="cs-card">
          <div class="cs-badge">Case Study</div>
          <h3>Multi-Doctor Integrated Rehab Clinic</h3>
          <p class="cs-stat"><b>118</b> Reactivated Patients</p>
          <p class="cs-desc">
            Implemented the ChiroCandy Patient Reactivation Engine across a dormant database of 1,400 past patients who had not visited in 6+ months, generating 118 booked adjustments in 21 days.
          </p>
          <ul class="cs-highlights">
            <li><strong>Challenge:</strong> Large unmonetized inactive patient list with zero systematic follow-up.</li>
            <li><strong>Solution:</strong> 4-part automated SMS &amp; email reactivation sequence with zero ad spend.</li>
            <li><strong>Result:</strong> $42,000+ in estimated re-established care plan value with 98% positive patient feedback.</li>
          </ul>
        </article>

        <article class="cs-card">
          <div class="cs-badge">Case Study</div>
          <h3>Solo Pediatric &amp; Prenatal Practitioner</h3>
          <p class="cs-stat"><b>#1</b> Map Pack Ranking</p>
          <p class="cs-desc">
            Complete local SEO and AEO website overhaul targeting pediatric, pregnancy, and family wellness search intent, moving from unranked to the #1 Google Map Pack position in a competitive suburban market.
          </p>
          <ul class="cs-highlights">
            <li><strong>Challenge:</strong> Outdated website with no schema markup and zero organic search visibility.</li>
            <li><strong>Solution:</strong> Answer-first site architecture, schema markup, and Google Business Profile authority optimization.</li>
            <li><strong>Result:</strong> 310% increase in organic phone calls and direct website appointment bookings.</li>
          </ul>
        </article>
      </div>

      <div class="cs-cta-box">
        <h3>Ready to build predictable patient growth for your practice?</h3>
        <p>Book a 1-on-1 practice growth strategy session. We will analyze your local market and build a custom acquisition blueprint for your clinic.</p>
        <a href={SITE.scheduleUrl} class="btn btn-green">Book a Strategy Call <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-intro {
    max-width: 72ch;
    margin-bottom: 2.5rem;
  }
  .cs-intro h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.8rem;
    color: var(--ink);
  }
  .cs-intro p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }
  .cs-card {
    background: var(--paper, #ffffff);
    border: 1px solid var(--border, rgba(18, 57, 100, 0.12));
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(4, 16, 31, 0.04);
    display: flex;
    flex-direction: column;
  }
  .cs-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--green-dark, #3d9a2e);
    background: rgba(76, 175, 60, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .cs-card h3 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }
  .cs-stat {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cs-stat b {
    font-size: 2rem;
    color: var(--green-dark, #3d9a2e);
    font-family: 'Space Grotesk', sans-serif;
    display: block;
    line-height: 1.1;
  }
  .cs-desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }
  .cs-highlights {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    border-top: 1px solid var(--border, rgba(18, 57, 100, 0.08));
    padding-top: 1rem;
    font-size: 0.88rem;
    color: var(--text);
    display: grid;
    gap: 0.55rem;
  }
  .cs-highlights li strong {
    color: var(--ink);
  }
  .cs-cta-box {
    background: linear-gradient(135deg, rgba(7, 28, 54, 0.96), rgba(18, 57, 100, 0.92));
    border-radius: 20px;
    padding: 3rem 2.5rem;
    text-align: center;
    color: #fff;
    border: 1px solid rgba(126, 217, 87, 0.24);
  }
  .cs-cta-box h3 {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin: 0 0 0.8rem;
    color: #fff;
  }
  .cs-cta-box p {
    color: var(--muted2, #a2b4cc);
    max-width: 58ch;
    margin: 0 auto 1.8rem;
    font-size: 1.05rem;
  }
</style>

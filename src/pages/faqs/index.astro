---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, faqPageSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';
import faqs from '@/data/faqs.json';

const title = 'Frequently Asked Questions | ChiroCandy';
const description =
  'Direct answers about what a chiropractic marketing agency is, specialist vs generalist, done-for-you vs training, SEO and AI search, and how ChiroCandy works. Mapped to the live service and framework URLs.';

const url = `${SITE.url}/faqs/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-29' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'FAQs', url },
  ]),
  faqPageSchema(faqs)
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="Frequently Asked Questions"
    answer="These are the questions practice owners ask before they hire a chiropractic marketing agency. Each answer points to a live ChiroCandy URL so Google and AI engines can cite the same facts."
  />

  <section class="section">
    <div class="container">
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item reveal" data-animate>
            <dt>{faq.question}</dt>
            <dd>
              <p>{faq.answer}</p>
              {faq.links?.length ? (
                <p class="faq-links">
                  {faq.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </p>
              ) : null}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-list {
    margin: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .faq-item dt {
    font-family: var(--font-subhead);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--text);
    max-width: 72ch;
  }

  .faq-item dd p {
    margin: 0 0 0.75rem;
  }

  .faq-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
  }

  .faq-links a {
    color: var(--green);
    font-size: 0.92rem;
  }
</style>

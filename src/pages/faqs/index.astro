---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, faqPageSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';
import faqs from '@/data/faqs.json';

const title = 'Frequently Asked Questions | ChiroCandy';
const description =
  'Get direct answers about chiropractic and healthcare practice marketing, Facebook ads, SEO, web design, and working with ChiroCandy. FAQs for practice owners researching how to grow.';

const url = `${SITE.url}/faqs/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-06-09' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'FAQs', url },
  ]),
  faqPageSchema(faqs)
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="Frequently Asked Questions"
    answer="These are the questions chiropractic and healthcare practice owners ask most about marketing, websites, ads, and working with ChiroCandy. Each answer is written to help you decide your next step."
  />

  <section class="section">
    <div class="container">
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item reveal" data-animate>
            <dt>{faq.question}</dt>
            <dd set:html={faq.answer.replace(/Chiropractic Facebook ads in the U\.S\./g, '<a href="/services/facebook-advertising/">Chiropractic Facebook ads</a>')} />
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-list {
    margin: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .faq-item dt {
    font-family: var(--font-subhead);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--text);
    max-width: 72ch;
  }

  .faq-item dd :global(a) {
    color: var(--green-dark);
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BuyerResources from '@/components/BuyerResources.astro';
import { buildGraph, breadcrumbSchema, faqPageSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';
import faqs from '@/data/faqs.json';

const title = 'Frequently Asked Questions | ChiroCandy';
const description =
  'Get direct answers about chiropractic and healthcare practice marketing, Facebook ads, SEO, web design, and working with ChiroCandy. FAQs for practice owners researching how to grow.';

const url = `${SITE.url}/faqs/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'FAQs', url },
  ]),
  faqPageSchema(faqs)
);
const categories = ['Working together', 'Costs and commitments', 'Measurement and results', 'Privacy and responsibility'];
const categoryId = (category: string) => category.toLowerCase().replace(/ /g, '-');
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="Frequently Asked Questions"
    answer="These are the questions chiropractic and healthcare practice owners ask most about marketing, websites, ads, and working with ChiroCandy. Each answer is written to help you decide your next step."
  />

  <section class="section">
    <div class="container">
      <nav class="faq-topics" aria-label="FAQ topics">{categories.map(category => <a href={`#${categoryId(category)}`}>{category}</a>)}</nav>
      {categories.map(category => (
        <section class="faq-group" id={categoryId(category)} aria-labelledby={`heading-${categoryId(category)}`}>
          <h2 id={`heading-${categoryId(category)}`}>{category}</h2>
          <dl class="faq-list">{faqs.filter(faq => faq.category === category).map(faq => (
            <div class="faq-item"><dt>{faq.question}</dt><dd>{faq.answer}</dd></div>
          ))}</dl>
        </section>
      ))}
      <p><a href="/pricing/">Explore marketing costs</a> · <a href="/marketing-calculator/">Run a planning scenario</a> · <a href="/privacy-policy/">Read the privacy policy</a></p>
    </div>
  </section>
  <BuyerResources />
</BaseLayout>

<style>
  .faq-topics { display: flex; flex-wrap: wrap; gap: .8rem; margin-bottom: 3rem; }
  .faq-topics a { border: 1px solid var(--line); padding: .75rem 1rem; border-radius: 12px; font-size: .85rem; }
  .faq-group { margin-bottom: 3rem; scroll-margin-top: 110px; }
  .container > p a { color: var(--green); }
  .faq-list {
    margin: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .faq-item dt {
    font-family: var(--font-subhead);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--text);
    max-width: 72ch;
  }

  .faq-item dd :global(a) {
    color: var(--green-dark);
  }
</style>

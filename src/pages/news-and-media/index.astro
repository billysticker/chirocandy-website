---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const title = 'News and Media | ChiroCandy';
const description =
  'ChiroCandy in the press and on podcasts. Media mentions, founder interviews, and appearances covering chiropractic and healthcare practice growth.';
const url = `${SITE.url}/news-and-media/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-25' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'News and Media', url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="News and Media"
    answer="Billy Sticker and ChiroCandy appear in press, podcasts, and industry events covering chiropractic and healthcare practice growth, AI, and patient acquisition."
    eyebrow="Press"
  />
  <section class="section">
    <div class="container prose">
      <p>
        ChiroCandy has been featured across broadcast and business media, including FOX, CBS, NBC, Forbes, and Inc. 5000 recognition. For interviews or brand assets, email
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <h2>Where to start</h2>
      <ul>
        <li><a href="/about/billy-sticker/">Billy Sticker credentials</a></li>
        <li><a href="/podcasts/">ChiroCandy podcast archive</a></li>
        <li><a href="/testimonials/">Client video testimonials</a></li>
      </ul>
      <h2>Listen to a published conversation</h2>
      <p><a href="https://podcasts.apple.com/us/podcast/billy-sticker-on-ai-marketing-chiropractic-growth-getting/id1320476198?i=1000774686405" target="_blank" rel="noopener noreferrer">Billy Sticker on AI Marketing, Chiropractic Growth &amp; Getting More New Clients — Chiropractic Mindset Mastery Podcast ↗</a></p>
      <p>This is a podcast appearance, not an award or an endorsement of every ChiroCandy service. Listen to the original conversation for context.</p>
      <h2>How to evaluate recognition</h2>
      <p>A business-growth award, a media appearance, and a professional role describe different things. Look for the issuer, year, selection criteria, and original source. None establishes the result your own practice will achieve.</p>
      <div class="inner-cta">
        <a class="btn btn--primary" href={SITE.scheduleUrl}>Book a Strategy Call</a>
      </div>
    </div>
  </section>
</BaseLayout>

const faqs = [
 {question:'What is a patient reactivation campaign?',answer:'A reactivation campaign invites eligible former patients to reconnect with a practice. It uses a defined audience, approved messages, reply handling, and a clear next step.'},
 {question:'Is reactivation always cheaper than new-patient advertising?',answer:'No. Compare the actual campaign costs and attended return visits. List quality, available permissions, offer, follow-up, and appointment capacity affect the result.'},
 {question:'How quickly should we expect results?',answer:'Set a review window for the campaign rather than assuming a response rate or a number of days. Track delivered messages, replies, bookings, and attended visits separately.'},
 {question:'Does every former patient belong in the campaign?',answer:'No. Have the practice review eligibility, contact preferences, prior opt-outs, and whether the outreach is appropriate before using a list.'},
 {question:'What should an offer say?',answer:'Use a clear, practice-approved invitation with an accurate description of the next step and any terms. A return visit should be appropriate to the person; avoid assuming that every former patient needs ongoing treatment.'},
];

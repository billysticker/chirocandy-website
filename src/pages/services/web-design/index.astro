  includeFaqSchema={false}
  heroTitle="Chiropractic Website Design Services for Established Practices"
  heroAnswer="A website redesign should begin with a written scope for content, migration, booking, ownership, and launch acceptance—not a promise that a new design will automatically rank or produce appointments. ChiroCandy provides custom chiropractic websites; the exact deliverables, access, support, and agreement terms should be confirmed for your practice before work begins."
  serviceName="Chiropractic Website Design"
  faqs={[

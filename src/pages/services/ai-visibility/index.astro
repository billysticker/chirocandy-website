    padding: 1rem 1.1rem;
    color: var(--green);
    font-weight: 600;
    text-align: left;
  }

  th,
  td {
    padding: 1rem 1.1rem;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }

  thead th {
    background: var(--surface-muted);
  }

  tbody th {
    min-width: 165px;
  }

  :is(a, .table-wrap):focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 4px;
  }
</style>

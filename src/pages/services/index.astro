---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { NAV, SITE } from '@/lib/site';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';

const title = 'Chiropractic Marketing Services | ChiroCandy';
const description =
  'ChiroCandy offers marketing services for chiropractic and healthcare practices including Facebook ads, Google Ads, SEO, web design, patient reactivation, and social media.';

const url = `${SITE.url}/services/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-06-09' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Services', url },
  ])
);

const summaries: Record<string, string> = {
  '/services/facebook-advertising/':
    'Targeted Facebook and Instagram campaigns that reach ideal chiropractic patients in your market.',
  '/services/google-advertising/':
    'Pay-per-click ads that put your practice at the top of Google when patients search for care.',
  '/services/search-engine-optimization/':
    'Local SEO and AI search so your practice is findable in Google, Maps, ChatGPT, and Copilot.',
  '/services/web-design/':
    'Conversion-focused chiropractic websites built for speed, mobile, and search visibility.',
  '/services/reactivation-campaigns/':
    'Email and messaging systems that bring inactive patients back to your schedule.',
  '/services/chiropractic-social-media-marketing/':
    'Done-for-you social content that keeps your practice visible and trusted online.',
};

const programBlurb: Record<string, string> = {
  '/get-new-patients/':
    'Ads, follow-up, and booking so new patients show up instead of dying in the inbox.',
  '/done-for-you-program/':
    'ChiroCandy runs the system. Your team stays on care. Month-to-month after the start period.',
  '/training-program/':
    'Your staff learns the same frameworks and playbooks, then executes in-house with coaching.',
};
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title="Chiropractic marketing services"
    answer="ChiroCandy builds patient acquisition systems for chiropractic and healthcare practices. Pick the service that matches your growth stage, or combine ads, SEO, and web design into one coordinated plan."
  />

  <section class="section">
    <div class="container card-grid">
      {NAV.services.map((service) => (
        <a href={service.href} class="card reveal" data-animate>
          <h2>{service.label}</h2>
          <p>{summaries[service.href]}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Programs that put the services to work</h2>
      <p class="lede">
        Services are the channels. Programs are how you buy the system. Get New Patients is the
        acquisition engine. Done-for-you is ChiroCandy executing. Training is your team executing
        with our playbooks.
      </p>
      <div class="card-grid">
        {NAV.programs.map((program) => (
          <a href={program.href} class="card reveal" data-animate>
            <h2>{program.label}</h2>
            <p>{programBlurb[program.href]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .lede {
    max-width: 68ch;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }

  .section--alt {
    padding-top: 0;
  }

  .section--alt h2 {
    margin-bottom: 0.75rem;
  }
</style>

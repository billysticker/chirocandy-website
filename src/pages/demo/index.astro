---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const title = 'Demo | ChiroCandy';
const description =
  'See the ChiroCandy growth system: ads, SEO, websites, CTV, reactivation, and AI follow-up for chiropractic and healthcare practices. Book a strategy call for a live walkthrough.';
const url = `${SITE.url}/demo/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-25' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Demo', url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema} noindex>
  <PageHero
    title="See the system"
    answer="The fastest demo is the homepage AI follow-up and the strategy call. Watch how the engine works, then get a diagnosis for your market."
  />
  <section class="section">
    <div class="container prose">
      <p>
        The public demo lives on the homepage: a live AI patient coordinator plus a video explaining the growth engine. For a live review of your market, book a strategy call.
      </p>
      <div class="inner-cta">
        <a class="btn btn--secondary" href="/#ai">Run the AI demo</a>
        <a class="btn btn--primary" href={SITE.scheduleUrl}>Book a Strategy Call</a>
      </div>
    </div>
  </section>
</BaseLayout>

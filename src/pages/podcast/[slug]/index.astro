---
import PodcastLayout from '@/layouts/PodcastLayout.astro';
import podcasts from '@/data/podcasts.json';
import { episodeDisplayTitle, relatedEpisodes, episodeSeoDescription, secureAudioUrl } from '@/lib/podcasts';

export function getStaticPaths() {
  return podcasts.map((episode) => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;

const summary =
  episode.body.split('\n\n')[0]?.slice(0, 280) ??
  episode.meta_description;
const related = relatedEpisodes(episode, podcasts);
---

<PodcastLayout
  title={episode.title}
  description={episodeSeoDescription(episode)}
  slug={episode.slug}
  h1={episodeDisplayTitle(episode)}
  body={episode.body}
  audioUrl={secureAudioUrl(episode.audioUrl)}
  datePublished={episode.datePublished}
  dateModified={episode.dateModified}
  summary={summary}
  related={related.map((item) => ({
    href: `/podcast/${item.slug}/`,
    label: episodeDisplayTitle(item),
  }))}
/>

---
import AiWebsiteWorkbook from '@/components/AiWebsiteWorkbook.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  WORKBOOK_FAQS,
  WORKBOOK_ITEM_COUNT,
  WORKBOOK_SECTIONS,
} from '@/data/ai-website-workbook';
import { buildGraph, breadcrumbSchema, faqPageSchema, howToSchema, webPageSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const title = 'AI Website Workbook for Chiropractors | ChiroCandy';
const description =
  'Free AI website workbook for chiropractic and healthcare practices. Score whether Google, ChatGPT, Copilot, and Perplexity can find, quote, and cite your site — then close the gaps.';
const url = `${SITE.url}/ai-website-workbook/`;
const schema = buildGraph(
  webPageSchema({
    url,
    name: title,
    description,
    datePublished: '2026-09-16',
    dateModified: '2026-09-16',
    speakable: ['.workbook-hero h1', '.lede'],
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'AI Website Workbook', url },
  ]),
  faqPageSchema([...WORKBOOK_FAQS]),
  howToSchema({
    name: 'How to audit a chiropractic website for AI search',
    description:
      'Use the ChiroCandy AI Website Workbook to score identity, crawlability, answer-first content, schema, proof, and booking so answer engines can cite the practice.',
    steps: [
      { name: 'Name the practice', text: 'Record the legal name, URL, city, and lead doctor so the audit is tied to one entity.' },
      {
        name: 'Score the eight sections',
        text: `Mark ${WORKBOOK_ITEM_COUNT} checks as yes, partial, or no across identity, crawlability, answers, schema, AI files, trust, conversion, and local discovery.`,
      },
      {
        name: 'Write three patient questions',
        text: 'Draft the questions a new patient would ask and one 40–70 word answer capsule a stranger could quote.',
      },
      {
        name: 'Close the gaps or get help',
        text: 'Print the score, fix the missing items, or book a ChiroCandy strategy call for a rebuild that is built to be cited.',
      },
    ],
  })
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema} bodyClass="workbook-page">
  <section class="workbook-hero container">
    <p class="eyebrow">Free practice website audit</p>
    <h1>AI Website Workbook</h1>
    <p class="lede answer-first">
      Patients now ask ChatGPT, Google AI Overviews, Copilot, and Perplexity who to see. This workbook scores whether your chiropractic or healthcare website can be crawled, quoted, and cited — then shows what to fix before you buy more traffic.
    </p>
    <div class="hero-notes">
      <span>{WORKBOOK_SECTIONS.length} sections · {WORKBOOK_ITEM_COUNT} checks</span>
      <span>No email required</span>
      <span>Saves in this browser</span>
      <a href="#workbook-form">Start the audit ↓</a>
    </div>
  </section>

  <section class="section workbook-section">
    <div class="container workbook-wrap">
      <AiWebsiteWorkbook />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <p class="eyebrow">Why this exists</p>
      <h2>What makes a practice website usable by AI search?</h2>
      <p>
        Answer engines do not “visit” your site the way a patient does. They retrieve crawlable HTML, look for a resolvable business name, and lift short passages that answer a question. If the first paragraph is a slogan, the booking path is a contact form, or the proof is anonymous, the model quotes someone else.
      </p>
      <p>
        ChiroCandy builds that source layer as part of <a href="/services/web-design/">chiropractic web design</a> and <a href="/services/search-engine-optimization/">SEO and AI search</a>: question-led pages, JSON-LD, <code>llms.txt</code>, named proof, and a booking path that still works at 11pm. The workbook is the same checklist, usable without a call.
      </p>
      <h2>How should you use the score?</h2>
      <p>
        Treat it as a planning audit, not a ranking prediction. A high score means the raw material is in place. A low score means ads and GBP posts are pointing at a brochure. Print the page, share it with your webmaster, or <a href="/schedule/">book a strategy call</a> and we will walk the same sections against your live URL.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Workbook FAQ</h2>
      <dl class="faq-list">
        {WORKBOOK_FAQS.map((faq) => (
          <div class="faq-item">
            <dt>{faq.question}</dt>
            <dd>{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .workbook-hero {
    padding-block: clamp(3.4rem, 7vw, 5.8rem) 1.5rem;
  }

  h1 {
    font-size: clamp(2.4rem, 5.4vw, 4.3rem);
    max-width: 14ch;
    margin: 1rem 0 1.2rem;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 68ch;
  }

  .hero-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    margin-top: 1.6rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .hero-notes a {
    color: var(--green);
  }

  .workbook-wrap {
    max-width: 860px;
  }

  .workbook-section {
    padding-top: 1.5rem;
  }

  #workbook-form {
    scroll-margin-top: 90px;
  }

  .faq-list {
    margin: 1.5rem 0 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1.15rem 0;
  }

  .faq-item dt {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--text-muted);
    max-width: 72ch;
  }

  code {
    font-size: 0.92em;
    color: var(--green);
  }
</style>

<style is:global>
  @media print {
    body.workbook-page {
      background: #fff;
      color: #122;
    }

    .workbook-page :is(#nav, .mobile-menu, .site-foot, .cc-bar, .cc-reopen, .hero-notes, .toolbar-actions, .section--alt, .section:has(.faq-list), .inner-cta) {
      display: none !important;
    }

    .workbook-page .workbook-hero {
      padding: 0 0 1rem;
    }

    .workbook-page .workbook-hero h1,
    .workbook-page .workbook-card h2,
    .workbook-page legend,
    .workbook-page .score-line,
    .workbook-page .section-q {
      color: #04101f;
    }

    .workbook-page :is(.lede, .answer-first, .hint, label, dd, p) {
      color: #223;
    }

    .workbook-page :is(.workbook-toolbar, .workbook-card, fieldset) {
      background: #fff;
      border-color: #d7dee8;
      box-shadow: none;
      break-inside: avoid;
    }

    .workbook-page input,
    .workbook-page textarea {
      background: #fff;
      color: #04101f;
      border-color: #c9d3e0;
    }
  }
</style>

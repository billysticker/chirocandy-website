---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';
import { BILLY_STICKER, SITE } from '@/lib/site';

const title = 'Billy Sticker | Founder & CEO | ChiroCandy';
const description =
  'Billy Sticker founded ChiroCandy in 2015. Over 11 years he has helped more than 2,000 chiropractic and healthcare practices build patient growth through founder-led marketing systems.';

const url = `${SITE.url}/about/billy-sticker/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-06-09' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'About Us', url: `${SITE.url}/about-us/` },
    { name: BILLY_STICKER.name, url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title={BILLY_STICKER.name}
    answer={BILLY_STICKER.description}
    eyebrow={BILLY_STICKER.jobTitle}
  />

  <section class="section">
    <div class="container prose">
      <h2>Who is Billy Sticker?</h2>
      <p>
        Billy Sticker is the founder and CEO of ChiroCandy Marketing, LLC and co-founder of
        HireZim.ai. He started ChiroCandy in 2015 as a podcast to support chiropractors and grew
        it into a marketing agency for chiropractic and healthcare practices, recognized on the Inc. 5000 list.
      </p>
      <p>
        Over 11 years, Billy has helped more than 2,000 chiropractic and healthcare offices
        generate more than $450 million in revenue through smarter marketing, stronger visibility,
        and practical growth systems.
      </p>
      <h2>What does Billy focus on?</h2>
      <p>
        Billy’s work connects practice marketing, patient follow-up, and the way a team turns
        inquiries into appointments. Explore ChiroCandy’s frameworks and published conversations
        to understand the approach, then compare the evidence with your practice’s needs.
      </p>
      <h2>Explore the work</h2>
      <ul>
        <li><a href="/frameworks/known-found-trusted/">Known / Found / Trusted</a>: the framework behind the agency’s approach.</li>
        <li><a href="/podcasts/">ChiroCandy podcast archive</a>: conversations about practice growth and marketing.</li>
        <li><a href="/case-studies/">Client case studies</a>: individual experiences with their source context.</li>
        <li><a href="/marketing-calculator/">Marketing planning calculator</a>: work through your own practice economics.</li>
      </ul>
      <h2>Professional profiles</h2>
      <p><a href="https://www.linkedin.com/in/billysticker" target="_blank" rel="noopener noreferrer">Billy on LinkedIn ↗</a> · <a href="https://www.youtube.com/c/BillySticker" target="_blank" rel="noopener noreferrer">Billy’s YouTube channel ↗</a></p>
      <p><a href="/about-us/">About ChiroCandy</a> · <a href="/contact-us/">Contact the team</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { buildGraph, breadcrumbSchema, webPageSchema } from '@/lib/schema';
import { BILLY_STICKER, SITE } from '@/lib/site';

const title = 'Billy Sticker | Founder & CEO | ChiroCandy';
const description =
  'Billy Sticker founded ChiroCandy in 2015. Over 11 years he has helped more than 2,000 chiropractic offices build patient growth through marketing systems built only for chiropractors.';

const url = `${SITE.url}/about/billy-sticker/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-06-09' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'About Us', url: `${SITE.url}/about-us/` },
    { name: BILLY_STICKER.name, url },
  ])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero
    title={BILLY_STICKER.name}
    answer={BILLY_STICKER.description}
    eyebrow={BILLY_STICKER.jobTitle}
  />

  <section class="section">
    <div class="container prose">
      <h2>Who is Billy Sticker?</h2>
      <p>
        Billy Sticker is the founder and CEO of ChiroCandy Marketing, LLC and co-founder of
        HireZim.ai. He started ChiroCandy in 2015 as a podcast to support chiropractors and grew
        it into a chiropractic-only marketing agency recognized on the Inc. 5000 list.
      </p>
      <p>
        Over 11 years, Billy has helped more than 2,000 chiropractic and healthcare offices
        generate more than $450 million in revenue through smarter marketing, stronger visibility,
        and practical growth systems.
      </p>
      <h2>Why does author credibility matter?</h2>
      <p>
        Chiropractic practice owners need advice from people who have executed campaigns at scale
        inside the profession. Billy's track record is the foundation of ChiroCandy's E-E-A-T
        across blog posts, podcast episodes, and service recommendations on this site.
      </p>
      <p><a href="/about-us/">About ChiroCandy</a> · <a href="/contact-us/">Contact the team</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }
</style>

---
import { fields } from '@/lib/marketing-calculator.mjs';
import { SITE } from '@/lib/site';
const groups = [
  { title: 'Your investment', subtitle: 'One month of acquisition spending', fields: fields.slice(0, 3) },
  { title: 'Your conversion path', subtitle: 'Use each stage’s own denominator', fields: fields.slice(3, 6) },
  { title: 'Your patient economics', subtitle: 'Value that cohort over its first 90 days', fields: fields.slice(6) },
];
---

<section class="calculator container" aria-labelledby="calculator-heading" data-calculator>
  <div class="calc-topline">
    <div><p class="eyebrow">Your practice. Your assumptions.</p><h2 id="calculator-heading">Make the numbers work.</h2></div>
    <button type="button" class="calc-example" data-example hidden>Try an example <span aria-hidden="true">↗</span></button>
  </div>
  <noscript><p class="calc-notice">Enable JavaScript to use the calculator. The formulas and a worked example are explained below.</p></noscript>
  <div class="calc-layout">
    <form novalidate data-calculator-form autocomplete="off">
      {groups.map((group, index) => (
        <fieldset>
          <legend><span class="step-number">0{index + 1}</span>{group.title}</legend>
          <p class="group-help">{group.subtitle}</p>
          <div class="calc-fields">
            {group.fields.map((field) => (
              <div class="calc-field">
                <label for={`calc-${field.key}`}>{field.label}</label>
                <div class="input-shell"><span aria-hidden="true">{field.unit}</span><input
                  id={`calc-${field.key}`} name={field.key} type="number" inputmode="decimal"
                  min={field.min} max={field.max} step={field.step} required placeholder="Enter your number"
                  aria-describedby={`help-${field.key} error-${field.key}`}
                /></div>
                <p class="field-help" id={`help-${field.key}`}>{field.help}</p>
                <p class="field-error" id={`error-${field.key}`} hidden></p>
              </div>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="calc-actions">
        <button type="submit" class="btn btn--primary" data-calculate disabled>Calculate my scenario <span aria-hidden="true">→</span></button>
        <button type="button" class="calc-clear" data-clear hidden>Clear numbers</button>
      </div>
      <p class="calc-status" role="status" aria-live="polite" data-status>Enter your numbers, or load an illustrative example.</p>
    </form>

    <aside class="calc-results" aria-labelledby="results-title">
      <p class="eyebrow">The growth picture</p>
      <h2 id="results-title">Your scenario</h2>
      <p class="result-mode" data-result-mode>Enter your assumptions to see the result.</p>
      <div data-empty>
        <div class="empty-number" aria-hidden="true">—</div>
        <p>What does it take to turn your marketing investment into patients?</p>
        <ol class="empty-steps"><li>Start with your budget.</li><li>Follow the path from lead to patient.</li><li>Compare contribution with your costs.</li></ol>
      </div>
      <div data-results hidden>
        <div class="result-hero"><output data-output="patients">—</output><span>scenario patients acquired per month</span></div>
        <dl class="result-metrics">
          <div><dt>Total monthly marketing spend</dt><dd data-output="totalSpend">—</dd></div>
          <div><dt>Marketing cost per acquired patient</dt><dd data-output="costPerPatient">—</dd></div>
          <div><dt>90-day collections from that cohort</dt><dd data-output="cohortCollections">—</dd></div>
          <div class="result-emphasis"><dt>After care &amp; marketing costs</dt><dd data-output="afterMarketing">—</dd></div>
          <div><dt>Return on marketing spend, after care costs</dt><dd data-output="marketingReturn">—</dd></div>
          <div><dt>Whole patients needed to break even</dt><dd data-output="breakEvenPatients">—</dd></div>
        </dl>
        <p class="result-explanation" data-verdict></p>
        <h3>Follow the conversion path</h3>
        <ol class="funnel">
          <li><span>Inquiries</span><b data-output="leads">—</b></li>
          <li><span>Appointments booked</span><b data-output="bookings">—</b></li>
          <li><span>Appointments attended</span><b data-output="attendees">—</b></li>
          <li><span>Patients acquired</span><b data-output="patients">—</b></li>
        </ol>
        <p class="result-fine">Fractional people represent scenario averages. Collections occur over the cohort’s first 90 days, not necessarily in the acquisition month. Fixed overhead and taxes are excluded. This is a planning scenario, not a forecast or a ChiroCandy quote.</p>
        <button type="button" class="calc-print" data-print>Print this scenario <span aria-hidden="true">↗</span></button>
      </div>
      <a class="btn btn--primary calc-cta" href={SITE.scheduleUrl}>Talk through my numbers <span aria-hidden="true">→</span></a>
      <p class="result-fine">Bring your assumptions to a strategy call. No email is required to use this tool.</p>
    </aside>
  </div>
</section>

<script>
  import { calculateMarketing, exampleInputs, fields } from '@/lib/marketing-calculator.mjs';
  const root = document.querySelector<HTMLElement>('[data-calculator]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const mode = root.querySelector<HTMLElement>('[data-result-mode]')!;
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const number = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });
    const fieldInputs = () => Array.from(form.querySelectorAll<HTMLInputElement>('input'));
    let illustrative = false;
    const clearErrors = () => {
      fieldInputs().forEach(input => {
        input.removeAttribute('aria-invalid');
        const error = root.querySelector<HTMLElement>(`#error-${input.name}`)!;
        error.textContent = '';
        error.hidden = true;
      });
    };
    function render() {
      clearErrors();
      const checked = calculateMarketing(Object.fromEntries(new FormData(form).entries()));
      if (!checked.valid || !checked.result) {
        results.hidden = true;
        empty.hidden = false;
        mode.textContent = 'Complete the inputs to see your scenario.';
        for (const [key, message] of Object.entries(checked.errors)) {
          const input = form.elements.namedItem(key) as HTMLInputElement;
          const error = root!.querySelector<HTMLElement>(`#error-${key}`)!;
          input.setAttribute('aria-invalid', 'true');
          error.textContent = String(message);
          error.hidden = false;
        }
        status.textContent = 'Please check the highlighted inputs. No result has been calculated.';
        form.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      const x = checked.result;
      const values: Record<string, string> = {
        leads: number.format(x.leads), bookings: number.format(x.bookings), attendees: number.format(x.attendees), patients: number.format(x.patients),
        totalSpend: usd.format(x.totalSpend), cohortCollections: usd.format(x.cohortCollections), afterMarketing: usd.format(x.afterMarketing),
        costPerPatient: x.costPerPatient === null ? 'No patients' : usd.format(x.costPerPatient),
        marketingReturn: x.marketingReturn === null ? 'No spend' : `${number.format(x.marketingReturn)}%`,
        breakEvenPatients: x.breakEvenPatients === null ? 'Not achievable' : number.format(x.breakEvenPatients),
      };
      root!.querySelectorAll<HTMLElement>('[data-output]').forEach(el => { el.textContent = values[el.dataset.output!]; });
      mode.textContent = illustrative ? 'Illustrative example · not typical results or quoted fees' : 'Calculated from your inputs · not a forecast';
      const verdict = root!.querySelector<HTMLElement>('[data-verdict]')!;
      verdict.textContent = x.breakEvenPatients === null
        ? 'With no contribution left after care costs, patient volume cannot cover positive marketing spend.'
        : x.totalSpend === 0
          ? 'No marketing spend is entered. This paid-acquisition model does not estimate organic or referral patients.'
          : x.afterMarketing < 0
            ? 'This scenario does not cover marketing spend within the 90-day collection window. Review your costs and conversion assumptions.'
            : 'This scenario covers marketing spend within the 90-day collection window. The amount left still needs to cover fixed overhead and taxes.';
      results.hidden = false;
      empty.hidden = true;
      status.textContent = `${illustrative ? 'Example' : 'Scenario'} calculated: ${number.format(x.patients)} patients and ${usd.format(x.afterMarketing)} after care and marketing costs.`;
    }
    root.querySelector<HTMLButtonElement>('[data-calculate]')!.disabled = false;
    root.querySelectorAll<HTMLButtonElement>('[data-example], [data-clear]').forEach(button => { button.hidden = false; });
    form.addEventListener('submit', event => { event.preventDefault(); render(); });
    form.addEventListener('input', () => {
      illustrative = false;
      clearErrors();
      results.hidden = true;
      empty.hidden = false;
      mode.textContent = 'Inputs changed. Recalculate to update your scenario.';
      status.textContent = 'Your numbers have changed. Select Calculate my scenario to update the result.';
    });
    root.querySelector('[data-example]')!.addEventListener('click', () => {
      fields.forEach(({ key }) => { (form.elements.namedItem(key) as HTMLInputElement).value = String(exampleInputs[key]); });
      illustrative = true;
      render();
    });
    root.querySelector('[data-clear]')!.addEventListener('click', () => {
      form.reset(); clearErrors(); illustrative = false; results.hidden = true; empty.hidden = false;
      mode.textContent = 'Enter your assumptions to see the result.';
      status.textContent = 'Numbers cleared. Enter your inputs or try an example.';
      fieldInputs()[0].focus();
    });
    root.querySelector('[data-print]')!.addEventListener('click', () => window.print());
  }
</script>

<style>
  .calculator { padding-block: 1rem 5rem; }
  .calc-topline { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding-bottom: 1.8rem; }
  .calc-topline h2 { margin: .4rem 0; font-size: clamp(1.7rem, 3vw, 2.4rem); }
  button { font-family: inherit; }
  button:focus-visible, input:focus-visible, a:focus-visible { outline: 3px solid var(--green); outline-offset: 4px; }
  .calc-example, .calc-print, .calc-clear { color: var(--green); background: transparent; border: 1px solid var(--line); border-radius: 10px; padding: .8rem 1rem; font-size: .9rem; cursor: pointer; }
  .calc-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  fieldset { border: 0; border-top: 1px solid var(--line); margin: 0 0 2.3rem; padding: 1.5rem 0 0; min-width: 0; }
  legend { font-family: var(--font-headline); font-size: 1.3rem; font-weight: 600; padding: 0 .8rem 0 0; }
  .step-number { font-size: .85rem; margin-right: .7rem; color: var(--green); }
  .group-help { margin: -.8rem 0 1.5rem; color: var(--muted); font-size: .85rem; }
  .calc-fields { display: grid; gap: 1.4rem; }
  label { display: block; font-size: .96rem; font-weight: 600; margin-bottom: .6rem; }
  .input-shell { display: flex; align-items: center; background: #0b2037; border: 1px solid #41566e; border-radius: 10px; }
  .input-shell:focus-within { border-color: var(--green); }
  .input-shell > span { padding-left: 1rem; color: var(--green); font-size: 1.1rem; }
  input { font: inherit; color: var(--white); background: none; border: 0; padding: .9rem 1rem; width: 100%; min-width: 0; }
  input::placeholder { color: #9aacc1; font-size: .9rem; }
  input[aria-invalid="true"] { outline: 2px solid #ffb6a8; border-radius: 10px; }
  .field-help, .field-error { font-size: .78rem; margin: .5rem 0 0; line-height: 1.5; color: var(--muted); }
  .field-error { color: #ffb6a8; }
  .calc-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .calc-status { font-size: .85rem; color: var(--muted); }
  .calc-results { background: linear-gradient(155deg, #112b43, #081b2c 65%); border: 1px solid #3b5569; border-radius: 22px; padding: clamp(1.4rem, 3vw, 2.3rem); position: sticky; top: 100px; }
  .calc-results > .eyebrow { margin-top: 0; }
  .calc-results h2 { font-size: 1.8rem; margin: .5rem 0; }
  .result-mode { font-size: .78rem; color: var(--muted); margin-bottom: 1.5rem; }
  .empty-number { font-size: 5rem; line-height: 1.3; color: var(--green); }
  [data-empty] > p { color: var(--white); font-size: 1.25rem; }
  .empty-steps { color: var(--muted); font-size: .9rem; padding-left: 1.2rem; line-height: 2; margin-bottom: 2.5rem; }
  .result-hero { display: grid; border-bottom: 1px solid var(--line); padding-bottom: 1.5rem; }
  .result-hero output { color: var(--green); font-family: var(--font-headline); font-size: clamp(3.5rem, 7vw, 5.5rem); letter-spacing: -.05em; line-height: 1.2; overflow-wrap: anywhere; }
  .result-hero span { color: var(--muted); font-size: .85rem; }
  .result-metrics { margin: 1rem 0; }
  .result-metrics > div { display: flex; align-items: baseline; gap: 1rem; justify-content: space-between; padding: .7rem 0; border-bottom: 1px solid var(--line); }
  dt { font-size: .8rem; color: var(--muted); max-width: 62%; }
  dd { margin: 0; font-family: var(--font-headline); font-weight: 600; text-align: right; overflow-wrap: anywhere; min-width: 0; }
  .result-emphasis dd { color: var(--green); }
  .result-explanation { font-size: .82rem; color: var(--white); }
  .calc-results h3 { font-size: .95rem; margin-top: 1.8rem; }
  .funnel { list-style: none; padding: 0; display: grid; gap: .35rem; font-size: .82rem; }
  .funnel li { display: flex; justify-content: space-between; gap: 1rem; padding: .55rem .75rem; background: rgba(126, 217, 87, .055); border-left: 2px solid #527766; }
  .funnel li:last-child { border-color: var(--green); background: rgba(126, 217, 87, .13); }
  .result-fine { font-size: .74rem; line-height: 1.6; color: var(--muted); }
  .calc-cta { width: 100%; margin-top: 1.6rem; text-align: center; }
  .calc-print { width: 100%; margin-top: .5rem; }
  [hidden] { display: none !important; }
  @media (max-width: 850px) { .calc-layout { grid-template-columns: 1fr; } .calc-results { position: static; } .calc-topline { align-items: start; flex-direction: column; } }
  @media print {
    .calculator { color: #111; width: 100%; padding: 0; }
    .calc-layout { grid-template-columns: 1fr 1fr; gap: 1rem; }
    .calc-results { position: static; background: white; border: 1px solid #777; border-radius: 0; padding: 1rem; }
    .calc-example, .calc-actions, .calc-print, .calc-cta, .calc-status, .field-help, .group-help, .empty-steps { display: none; }
    .calculator :is(h2, h3, p, span, label, legend, dt, dd, output, b, input) { color: #111 !important; }
    .calculator input { padding: .2rem; }
    .input-shell { background: white; border: 0; }
    fieldset { margin-bottom: 1rem; }
    .calc-fields { gap: .4rem; }
    label { font-size: .7rem; margin-bottom: 0; }
    .result-hero output { font-size: 3rem; }
  }
</style>

---
interface NavItem {
  href: string;
  label: string;
}

interface Props {
  label: string;
  items: readonly NavItem[] | NavItem[];
  numbered?: boolean;
  variant?: 'desktop' | 'mobile';
  hubHref?: string;
}

const { label, items, numbered = false, variant = 'desktop', hubHref } = Astro.props;

const isExternal = (href: string) => href.startsWith('http');
---

{
  variant === 'desktop' ? (
    <div class="nav-drop">
      <button class="nav-drop-toggle" type="button" aria-expanded="false" aria-haspopup="true">
        {label}
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
          <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <div class="nav-drop-panel" role="menu">
        {hubHref && (
          <a href={hubHref} role="menuitem">
            {numbered && <span class="nav-drop-num">00</span>}
            <span>All {label.toLowerCase()}</span>
          </a>
        )}
        {items.map((item, index) => (
          <a
            href={item.href}
            role="menuitem"
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          >
            {numbered && <span class="nav-drop-num">{String(index + 1).padStart(2, '0')}</span>}
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="mm-trainings">
      <p class="mm-trainings-label">{label}</p>
      {hubHref && <a href={hubHref}>All {label.toLowerCase()}</a>}
      {items.map((item) => (
        <a
          href={item.href}
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
  )
}

<style is:global>
  .nav-drop {
    position: relative;
  }
  .nav-drop-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    position: relative;
  }
  .nav-drop-toggle::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 0;
    background: var(--green);
    transition: width 0.25s;
  }
  .nav-drop:hover .nav-drop-toggle::after,
  .nav-drop.open .nav-drop-toggle::after,
  .nav-drop:focus-within .nav-drop-toggle::after {
    width: 100%;
  }
  .nav-drop-toggle svg {
    opacity: 0.7;
    transition: transform 0.2s;
  }
  .nav-drop:hover .nav-drop-toggle,
  .nav-drop:focus-within .nav-drop-toggle,
  .nav-drop.open .nav-drop-toggle {
    color: #fff;
  }
  .nav-drop:hover .nav-drop-toggle svg,
  .nav-drop.open .nav-drop-toggle svg {
    transform: rotate(180deg);
  }
  .nav-drop-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    min-width: 300px;
    padding: 0.55rem;
    background: rgba(7, 28, 54, 0.96);
    border: 1px solid rgba(126, 217, 87, 0.28);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s,
      visibility 0.2s,
      transform 0.2s;
    z-index: 70;
  }
  .nav-drop:hover .nav-drop-panel,
  .nav-drop:focus-within .nav-drop-panel,
  .nav-drop.open .nav-drop-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-drop-panel a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.72rem 0.85rem;
    border-radius: 11px;
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.25;
    position: static;
  }
  .nav-drop-panel a:not(:has(.nav-drop-num)) {
    grid-template-columns: 1fr;
  }
  .nav-drop-panel a::after {
    display: none;
  }
  .nav-drop-panel a:hover,
  .nav-drop-panel a:focus-visible {
    background: rgba(126, 217, 87, 0.1);
    color: #fff;
  }
  .nav-drop-num {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--green);
    font-weight: 600;
  }
  .mm-trainings {
    display: grid;
    gap: 0.7rem;
  }
  .mm-trainings-label {
    margin: 0.4rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }
  .mm-trainings a {
    font-size: 1.15rem !important;
    font-weight: 500 !important;
    color: var(--ink);
  }
</style>

<script>
  const bindNavDropdowns = () => {
    document.querySelectorAll('.nav-drop').forEach((drop) => {
      if (!(drop instanceof HTMLElement) || drop.dataset.bound === 'true') return;
      drop.dataset.bound = 'true';
      const toggle = drop.querySelector('.nav-drop-toggle');
      if (!(toggle instanceof HTMLButtonElement)) return;

      toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        document.querySelectorAll('.nav-drop.open').forEach((openDrop) => {
          if (openDrop !== drop) {
            openDrop.classList.remove('open');
            openDrop.querySelector('.nav-drop-toggle')?.setAttribute('aria-expanded', 'false');
          }
        });
        const open = drop.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });

      document.addEventListener('click', (event) => {
        if (!drop.contains(event.target as Node)) {
          drop.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    });
  };

  bindNavDropdowns();
  document.addEventListener('astro:page-load', bindNavDropdowns);
</script>

---
import {
  WORKBOOK_CAPSULE_FIELDS,
  WORKBOOK_IDENTITY_FIELDS,
  WORKBOOK_ITEM_COUNT,
  WORKBOOK_MAX_SCORE,
  WORKBOOK_SECTIONS,
  WORKBOOK_STORAGE_KEY,
} from '@/data/ai-website-workbook';
---

<form id="workbook-form" class="workbook" data-storage-key={WORKBOOK_STORAGE_KEY} data-item-count={WORKBOOK_ITEM_COUNT} data-max-score={WORKBOOK_MAX_SCORE}>
  <div class="workbook-toolbar">
    <div class="progress-copy">
      <p class="eyebrow">Your audit</p>
      <p id="workbookProgressLabel">0 of {WORKBOOK_ITEM_COUNT} checks answered</p>
    </div>
    <div class="progress-track" aria-hidden="true">
      <div id="workbookProgressBar" class="progress-bar"></div>
    </div>
    <div class="toolbar-actions">
      <button class="btn btn--secondary" type="button" data-workbook-print>Print / save PDF</button>
      <button class="btn btn--secondary" type="button" data-workbook-reset>Clear answers</button>
    </div>
  </div>

  <section class="workbook-card" aria-labelledby="identity-heading">
    <p class="eyebrow">Step 1</p>
    <h2 id="identity-heading">Name the practice</h2>
    <p class="answer-first">These fields print with your score. They never leave this browser.</p>
    <div class="identity-grid">
      {WORKBOOK_IDENTITY_FIELDS.map((field) => (
        <label>
          {field.label}
          <input type="text" name={field.id} autocomplete="off" placeholder={field.placeholder} />
        </label>
      ))}
    </div>
  </section>

  {WORKBOOK_SECTIONS.map((section, index) => (
    <section class="workbook-card" data-section={section.id} aria-labelledby={`${section.id}-heading`}>
      <p class="eyebrow">Step {index + 2}</p>
      <h2 id={`${section.id}-heading`}>{section.title}</h2>
      <p class="section-q">{section.question}</p>
      <p class="answer-first">{section.answer}</p>
      <ol class="check-list">
        {section.items.map((item) => (
          <li>
            <fieldset>
              <legend>{item.prompt}</legend>
              <p class="hint">{item.hint}</p>
              <div class="choices">
                <label>
                  <input type="radio" name={item.id} value="yes" />
                  Yes
                </label>
                <label>
                  <input type="radio" name={item.id} value="partial" />
                  Partial
                </label>
                <label>
                  <input type="radio" name={item.id} value="no" />
                  No
                </label>
              </div>
            </fieldset>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="workbook-card" aria-labelledby="capsule-heading">
    <p class="eyebrow">Step {WORKBOOK_SECTIONS.length + 2}</p>
    <h2 id="capsule-heading">Write three questions your site should answer</h2>
    <p class="answer-first">
      Pick the questions a new patient would ask out loud. Then draft one capsule. Aim for 40–70 words. Name the practice, the city, and the next step.
    </p>
    <div class="capsule-grid">
      {WORKBOOK_CAPSULE_FIELDS.map((field) => (
        <label class:list={[field.id === 'capsuleDraft' && 'wide']}>
          {field.label}
          <textarea name={field.id} rows={field.id === 'capsuleDraft' ? 6 : 2} placeholder={field.placeholder}></textarea>
        </label>
      ))}
    </div>
  </section>

  <section class="workbook-card result-card" aria-labelledby="result-heading">
    <p class="eyebrow">Result</p>
    <h2 id="result-heading">Your AI website score</h2>
    <p id="workbookScoreLine" class="score-line">Answer the checks to see a score.</p>
    <p id="workbookDiagnosis" class="answer-first">
      Yes counts as 2, partial as 1, no as 0. Unanswered items are excluded until you finish.
    </p>
    <div id="workbookGaps" class="gaps" hidden>
      <h3>Highest-leverage gaps</h3>
      <ul id="workbookGapList"></ul>
    </div>
    <div class="inner-cta">
      <a class="btn btn--primary" href="/schedule/">Book a strategy call</a>
      <a class="btn btn--secondary" href="/services/web-design/">See web design</a>
      <a class="btn btn--secondary" href="/services/search-engine-optimization/">See SEO &amp; AI search</a>
    </div>
  </section>
</form>

<script>
  import { diagnoseScore, scoreForValue } from '@/data/ai-website-workbook';

  const form = document.getElementById('workbook-form') as HTMLFormElement | null;
  if (form) {
    const storageKey = form.dataset.storageKey ?? 'chirocandy-ai-website-workbook';
    const itemCount = Number(form.dataset.itemCount || 0);
    const maxScore = Number(form.dataset.maxScore || 0);
    const progressLabel = document.getElementById('workbookProgressLabel');
    const progressBar = document.getElementById('workbookProgressBar');
    const scoreLine = document.getElementById('workbookScoreLine');
    const diagnosis = document.getElementById('workbookDiagnosis');
    const gaps = document.getElementById('workbookGaps');
    const gapList = document.getElementById('workbookGapList');

    const fieldNames = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name], textarea[name]')).reduce<string[]>((names, el) => {
      if (el.name && !names.includes(el.name)) names.push(el.name);
      return names;
    }, []);

    const radioNames = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="radio"]')).reduce<string[]>((names, el) => {
      if (el.name && !names.includes(el.name)) names.push(el.name);
      return names;
    }, []);

    function readState() {
      const data: Record<string, string> = {};
      const fd = new FormData(form!);
      for (const name of fieldNames) {
        const value = fd.get(name);
        if (typeof value === 'string' && value.trim()) data[name] = value;
      }
      return data;
    }

    function writeState(data: Record<string, string>) {
      for (const [name, value] of Object.entries(data)) {
        const radios = form!.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`);
        if (radios.length) {
          radios.forEach((radio) => {
            radio.checked = radio.value === value;
          });
          continue;
        }
        const field = form!.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
        if (field) field.value = value;
      }
    }

    function persist() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(readState()));
      } catch {
        /* private mode */
      }
    }

    function restore() {
      try {
        const raw = localStorage.getItem(storageKey);
        if (!raw) return;
        const parsed = JSON.parse(raw) as Record<string, string>;
        if (parsed && typeof parsed === 'object') writeState(parsed);
      } catch {
        /* ignore bad JSON */
      }
    }

    function render() {
      const state = readState();
      let answered = 0;
      let score = 0;
      const missing: { prompt: string; value: string }[] = [];

      for (const name of radioNames) {
        const value = state[name];
        const points = scoreForValue(value);
        if (points === null) continue;
        answered += 1;
        score += points;
        if (points < 2) {
          const legend = form!.querySelector(`input[name="${name}"]`)?.closest('fieldset')?.querySelector('legend');
          missing.push({ prompt: legend?.textContent?.trim() || name, value });
        }
      }

      if (progressLabel) {
        progressLabel.textContent = `${answered} of ${itemCount} checks answered`;
      }
      if (progressBar) {
        progressBar.style.width = `${itemCount ? Math.round((answered / itemCount) * 100) : 0}%`;
      }

      if (!scoreLine || !diagnosis) return;

      if (answered === 0) {
        scoreLine.textContent = 'Answer the checks to see a score.';
        diagnosis.textContent = 'Yes counts as 2, partial as 1, no as 0. Unanswered items are excluded until you finish.';
        if (gaps) gaps.hidden = true;
        return;
      }

      const denom = answered * 2;
      const pct = Math.round((score / denom) * 100);
      const result = diagnoseScore(score, denom);
      scoreLine.textContent = `${score} / ${denom} on answered items (${pct}%). Full workbook is ${maxScore} points.`;
      diagnosis.textContent = `${result.title}: ${result.summary}`;

      if (gaps && gapList) {
        const top = missing.slice(0, 5);
        gapList.replaceChildren();
        if (top.length) {
          gaps.hidden = false;
          top.forEach((item) => {
            const li = document.createElement('li');
            li.textContent = `${item.value === 'no' ? 'Missing' : 'Partial'} — ${item.prompt}`;
            gapList.appendChild(li);
          });
        } else {
          gaps.hidden = true;
        }
      }
    }

    restore();
    render();

    form.addEventListener('input', () => {
      persist();
      render();
    });
    form.addEventListener('change', () => {
      persist();
      render();
    });

    form.querySelector('[data-workbook-print]')?.addEventListener('click', () => window.print());
    form.querySelector('[data-workbook-reset]')?.addEventListener('click', () => {
      form.reset();
      try {
        localStorage.removeItem(storageKey);
      } catch {
        /* ignore */
      }
      render();
    });
  }
</script>

<style>
  .workbook {
    display: grid;
    gap: 1.5rem;
  }

  .workbook-toolbar,
  .workbook-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem 1.7rem;
    backdrop-filter: blur(12px);
  }

  .workbook-toolbar {
    display: grid;
    gap: 1rem;
  }

  .progress-track {
    height: 8px;
    border-radius: 99px;
    background: rgba(150, 171, 198, 0.16);
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(135deg, #9bf07a, #5cbf3e);
    transition: width 0.25s var(--ease);
  }

  .toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .toolbar-actions .btn {
    padding: 0.7rem 1.15rem;
    font-size: 0.88rem;
  }

  .workbook-card h2 {
    margin: 0.35rem 0 0.75rem;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
  }

  .section-q {
    color: var(--white);
    font-weight: 600;
    margin: 0 0 0.6rem;
  }

  .identity-grid,
  .capsule-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .capsule-grid .wide {
    grid-column: 1 / -1;
  }

  label {
    display: grid;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  input[type='text'],
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(4, 16, 31, 0.65);
    color: var(--white);
    padding: 0.85rem 0.95rem;
    font: inherit;
  }

  input[type='text']:focus,
  textarea:focus {
    outline: 2px solid var(--green);
    outline-offset: 1px;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }

  fieldset {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1rem 1.1rem 1.1rem;
  }

  legend {
    color: var(--white);
    font-weight: 600;
    padding: 0 0.35rem;
  }

  .hint {
    margin: 0.35rem 0 0.9rem;
    color: var(--muted2);
    font-size: 0.92rem;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .choices label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    color: var(--ink);
  }

  .choices input {
    accent-color: var(--green-dark);
  }

  .choices label:has(input:checked) {
    border-color: rgba(126, 217, 87, 0.7);
    background: var(--mint);
    color: var(--white);
  }

  .score-line {
    font-size: 1.2rem;
    color: var(--white);
    font-weight: 600;
  }

  .gaps h3 {
    margin: 1.4rem 0 0.6rem;
    font-size: 1.05rem;
  }

  .gaps ul {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--muted);
  }

  .gaps li {
    margin: 0.35rem 0;
  }

  @media (max-width: 720px) {
    .identity-grid,
    .capsule-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

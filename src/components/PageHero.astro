---
interface Props {
  title: string;
  answer: string;
  eyebrow?: string;
}

const { title, answer, eyebrow } = Astro.props;
---

<section class="page-hero">
  <div class="container hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="answer-first hero__answer">{answer}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding: 5.5rem 0 3.2rem;
    background: radial-gradient(900px 500px at 50% 0%, rgba(18, 57, 100, 0.45), transparent 70%);
  }
  .hero__inner {
    max-width: 760px;
  }
  .page-hero h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    margin: 0.8rem 0 1rem;
  }
  .hero__answer {
    margin: 0;
  }
</style>

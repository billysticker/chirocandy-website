---
import ComparisonGuide from '@/components/ComparisonGuide.astro';
import AnswerSummary from '@/components/AnswerSummary.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  blogPostingSchema,
  breadcrumbSchema,
  buildGraph,
  webPageSchema,
} from '@/lib/schema';
import { BILLY_STICKER, SITE } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  h1: string;
  summary: string;
  bodyHtml: string;
  datePublished: string;
  dateModified: string;
  crumbs: { name: string; href: string }[];
  canonicalPath: string;
}

const {
  title,
  description,
  h1,
  summary,
  bodyHtml,
  datePublished,
  dateModified,
  crumbs,
  canonicalPath,
} = Astro.props;

const isComparison = canonicalPath === '/blog/best-chiropractic-marketing-agencies/';
const readingMinutes = Math.max(1, Math.ceil(bodyHtml.replace(/<[^>]*>/g, ' ').split(/\s+/).length / 220));
const url = `${SITE.url}${canonicalPath}`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, datePublished, dateModified }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    ...crumbs.map((crumb) => ({ name: crumb.name, url: `${SITE.url}${crumb.href}` })),
    { name: h1, url },
  ]),
  blogPostingSchema({
    url,
    headline: h1,
    description,
    datePublished,
    dateModified,
  })
);
---

<BaseLayout title={title} description={description} canonical={url} ogType="article" schema={schema}>
  <article class:list={["section", { "comparison-page": isComparison }]}>
    <div class:list={["container", isComparison ? "comparison-shell" : "prose"]}>
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {
          crumbs.map((crumb) => (
            <>
              {' / '}
              <a href={crumb.href}>{crumb.name}</a>
            </>
          ))
        }
        {' / '}
        <span>{h1}</span>
      </nav>
      <p class="eyebrow">{isComparison ? "The practice owner’s guide" : <a href={BILLY_STICKER.url}>{BILLY_STICKER.name}</a>}</p>
      <h1>{h1}</h1>
      <AnswerSummary text={summary} />
      <p class="meta">
        {isComparison && <><a href="/about/billy-sticker/">By Billy Sticker</a>{` · ${readingMinutes} min read · `}</>}
        <time datetime={datePublished}>
          Published {new Date(datePublished).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
        {dateModified !== datePublished && (
          <>
            {' · '}
            <time datetime={dateModified}>
              Updated {new Date(dateModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
          </>
        )}
      </p>
      {isComparison ? <ComparisonGuide bodyHtml={bodyHtml} /> : <div class="article-body" set:html={bodyHtml} />}
      <aside class="author-bio" aria-labelledby="article-author-heading">
        <h2 id="article-author-heading">About Billy Sticker</h2>
        <p><a href={BILLY_STICKER.url}>{BILLY_STICKER.name}</a> is the founder of ChiroCandy.
          Explore his books, speaking, and work in AI and business growth at <a href={BILLY_STICKER.personalUrl}>BillySticker.com</a>.</p>
        <p class="author-bio__more">Explore more from the <a href="/blog/">ChiroCandy blog</a>.</p>
      </aside>
      <div class="inner-cta">
        <a class="btn btn--primary" href={SITE.scheduleUrl}>Book a Strategy Call</a>
        <a class="btn btn--secondary" href="/contact-us/">Contact us</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .crumb {
    font-size: 0.85rem;
    color: var(--muted2);
    margin-bottom: 1.4rem;
  }
  .meta {
    font-size: 0.85rem;
    color: var(--muted2);
  }
  .article-body :global(a:not(.btn)) {
    color: var(--green);
  }
  .article-body :global(h2),
  .article-body :global(h3) {
    margin-top: 2rem;
  }
  .article-body :global(p) {
    margin: 0 0 1rem;
  }
  .comparison-shell { max-width:1180px; }
  .comparison-page h1 { max-width:950px; font-size:clamp(2rem,4.5vw,3.6rem); line-height:1.12; letter-spacing:-.035em; }
  .comparison-page .meta { margin-top:1.5rem; }
  .comparison-page .meta a,.author-bio a { color:var(--green); text-decoration:underline; text-underline-offset:.15em; }
  .author-bio { margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid var(--line); }
  .author-bio h2 { margin:0 0 .75rem; font-size:1.25rem; }
  .author-bio p { color:var(--muted); margin:0; max-width:72ch; }
  .author-bio .author-bio__more { margin-top:.75rem; font-size:.9rem; }
  .comparison-page :global(.answer-summary) { max-width:850px; padding:1.25rem 1.5rem; border:1px solid var(--line); border-left:3px solid var(--green); border-radius:0 14px 14px 0; background:var(--panel); }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import {
  buildGraph,
  breadcrumbSchema,
  faqPageSchema,
  professionalServiceSchema,
  webPageSchema,
} from '@/lib/schema';
import { NAV, SITE } from '@/lib/site';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  heroTitle: string;
  heroAnswer: string;
  serviceName: string;
  faqs: FAQ[];
  relatedServices: { href: string; label: string }[];
}

const {
  title,
  description,
  slug,
  heroTitle,
  heroAnswer,
  serviceName,
  faqs,
  relatedServices,
} = Astro.props;

const url = `${SITE.url}/services/${slug}/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-31' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Services', url: `${SITE.url}/services/` },
    { name: heroTitle, url },
  ]),
  professionalServiceSchema(serviceName, description, url),
  faqPageSchema(faqs)
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero title={heroTitle} answer={heroAnswer} eyebrow="ChiroCandy Service" />

  <section class="section">
    <div class="container prose">
      <slot />

      <h2>Related services</h2>
      <ul>
        {relatedServices.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>

      <h2>Related programs</h2>
      <ul>
        {NAV.programs.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href="/frameworks/">Marketing frameworks</a></li>
        <li><a href="/case-studies/">Case studies</a></li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Service FAQ</h2>
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item">
            <dt>{faq.question}</dt>
            <dd>{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }

  .prose :global(h2) {
    margin-top: 2rem;
  }

  .prose :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.15rem;
  }

  .prose :global(h4) {
    margin-top: 1.25rem;
    font-size: 1rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .faq-item dt {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--text-muted);
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import {
  buildGraph,
  breadcrumbSchema,
  faqPageSchema,
  webPageSchema,
} from '@/lib/schema';
import { SITE } from '@/lib/site';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  heroTitle: string;
  heroAnswer: string;
  faqs?: FAQ[];
}

const { title, description, slug, heroTitle, heroAnswer, faqs = [] } = Astro.props;
const url = `${SITE.url}/${slug}/`;
const schema = buildGraph(
  webPageSchema({ url, name: title, description, dateModified: '2026-08-29' }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: heroTitle, url },
  ]),
  ...(faqs.length ? [faqPageSchema(faqs)] : [])
);
---

<BaseLayout title={title} description={description} canonical={url} schema={schema}>
  <PageHero title={heroTitle} answer={heroAnswer} />
  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>
  {faqs.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2>Program FAQ</h2>
        <dl class="faq-list">
          {faqs.map((faq) => (
            <div class="faq-item">
              <dt>{faq.question}</dt>
              <dd>{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}
  <section class="section section--alt">
    <div class="container cta-band">
      <a href={SITE.scheduleUrl} class="btn btn--primary">Schedule a Call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 72ch;
  }

  .cta-band {
    text-align: center;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .faq-item dt {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--text-muted);
  }
</style>
